---
import { execSync } from 'node:child_process';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Image } from 'astro:assets';
import Shot from '../components/landing/Shot.astro';
import Compare from '../components/landing/Compare.astro';
import CodePanel from '../components/landing/CodePanel.astro';
import Window from '../components/landing/Window.astro';

// The example screenshots come from docs/images of the checkout (main in the
// deploy job), next to the code the page shows; src/assets/wiki holds the
// docs' own copies.
import counter from '../../../docs/images/counter.png';
import dashboard from '../../../docs/images/dashboard.png';
import dashboardDark from '../../../docs/images/dashboard-dark.png';
import kit from '../../../docs/images/kit.png';
import kitDark from '../../../docs/images/kit-dark.png';
import notes from '../../../docs/images/notes.png';
import chat from '../../../docs/images/chat.png';
import player from '../../../docs/images/player.png';
import counterRaw from '../../../examples/counter/main.go?raw';

// The snippets of the tabs are the real sources of site/snippets, the ones
// scripts/render-snippets.sh renders with `tela snapshot` into the PNGs of
// assets/landing/ (the build check keeps them in sync). Both are found by tab id.
const snippetSources = import.meta.glob<string>('../../snippets/*/main.go', { query: '?raw', import: 'default', eager: true });
const snippetImages = import.meta.glob<ImageMetadata>('../assets/landing/*.png', { import: 'default', eager: true });

// The version of the chip and the status line: TELA_VERSION (the deploy sets
// it to the release tag), else the latest tag of the checkout.
const VERSION = process.env.TELA_VERSION || latestTag() || 'dev';
function latestTag(): string | undefined {
	try {
		return execSync("git describe --tags --abbrev=0 --match 'v*'", { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
	} catch {
		return undefined;
	}
}

// ---------- The counter of examples/counter/main.go ----------
// The file itself, without its comment lines and the Preview function that
// only `tela snapshot` and the tests use.
const counterSource = counterRaw
	.split('\n')
	.filter((line) => !line.startsWith('//'))
	.join('\n')
	.replace(/\n*func Preview\b[\s\S]*$/, '\n');

// ---------- Install ----------
const installLinux = [
	'CGO_ENABLED=0 go install github.com/kuronosu/tela/cmd/tela@latest',
	'tela new myapp',
	'cd myapp',
	'CGO_ENABLED=0 go run .',
];
const installWindows = [
	'$env:CGO_ENABLED = "0"',
	'go install github.com/kuronosu/tela/cmd/tela@latest',
	'tela new myapp',
	'cd myapp',
	'go run .',
];
const agentPrompt =
	'Read https://telaui.dev/llms.txt and build a Tela app: a notes list with a search field and a dark mode switch. Run tela snapshot after each change and fix what looks off.';
const mcpAdd = 'claude mcp add tela -- tela mcp ./myapp';

// ---------- Tabs: Go code and the PNG it renders ----------
const tabInfo = [
	{
		id: 'components',
		label: 'Components',
		blurb: 'kit has styled, accessible components in shadcn’s look. Restyle them with recipes.',
		alt: 'A card titled Notifications with a Pro badge, an Email field, a Weekly digest switch that is on and a Save changes button.',
	},
	{
		id: 'hooks',
		label: 'State and hooks',
		blurb: 'Hooks are named like React’s. The slider writes the state, the total follows.',
		alt: 'A tip calculator card with a slider at 18 percent and a total of $99.71.',
	},
	{
		id: 'styling',
		label: 'Tailwind styling',
		blurb: 'Tailwind v4 class names, verbatim, with hover:, active: and dark: variants.',
		alt: 'A card with an amber New badge, the heading Hot reload, a line of text and a dark Try it button.',
	},
	{
		id: 'layout',
		label: 'Layout',
		blurb: 'Real CSS grid and flex: spans, arbitrary tracks such as grid-rows-[1fr_1fr_auto].',
		alt: 'A three-column grid: one large tile spanning two columns and two rows, two small tiles beside it and a wide footer tile below.',
	},
	{
		id: 'theming',
		label: 'Theming',
		blurb: 'Components use tokens, so light and dark need no dark: classes. Scheme() gives a subtree its own.',
		alt: 'The same card twice, side by side: on the left in the light scheme, on the right in the dark one.',
	},
];
// The dark render is missing for theming, whose panels pin their own scheme.
const tabs = tabInfo.map((t) => {
	const src = snippetSources[`../../snippets/${t.id}/main.go`];
	const img = snippetImages[`../assets/landing/${t.id}.png`];
	if (!src || !img) {
		throw new Error(`The "${t.id}" tab needs site/snippets/${t.id}/main.go and src/assets/landing/${t.id}.png (run scripts/render-snippets.sh).`);
	}
	return { ...t, src, img, dark: snippetImages[`../assets/landing/${t.id}-dark.png`] };
});

// ---------- The loop: one terminal ----------
// Terminal lines are lists of [text, class] segments.
// p = prompt, c = command, o = output, d = dim, a = accent (amber), e = error.
type Seg = [string, string?];
type Line = Seg[];
const sh = (cmd: string): Line => [['$ ', 'p'], [cmd, 'c']];

const steps: { id: string; cmd: string; verb: string; title: string; body: string; lines: Line[]; shot?: boolean }[] = [
	{
		id: 'snapshot',
		cmd: 'tela snapshot',
		verb: 'Render',
		title: 'Render it to a PNG.',
		body: 'The same tree your window shows also renders to a PNG file, with no display server needed. Look at the pixels, or hand them to someone who will.',
		lines: [sh('tela snapshot --size 400x380 --scale 2 -o counter.png ./examples/counter')],
		shot: true,
	},
	{
		id: 'inspect',
		cmd: 'tela inspect',
		verb: 'Read',
		title: 'Read what a screen reader hears.',
		body: 'An aria snapshot in YAML: what assistive technology, a test or an agent sees. Add --layout for the boxes as JSON.',
		lines: [
			sh('tela inspect --size 800x600 ./examples/counter'),
			[['- text: COUNT', 'o']],
			[['- heading "0" [level=1]', 'o']],
			[['- button "Increment"', 'o']],
		],
	},
	{
		id: 'lint',
		cmd: 'tela lint',
		verb: 'Check',
		title: 'Catch the typo before it ships.',
		body: 'Unknown classes, roles and ARIA values, duplicate keys and misused hooks are found in the source, with a suggestion, even on screens nobody has rendered yet. It exits 1 when it reports something, so CI fails.',
		lines: [
			sh('tela lint ./...'),
			[
				['lintdemo/home.go:11:14: ', 'd'],
				['class: ', 'o'],
				['unknown class "rounded-xxl"; ', 'e'],
				['did you mean "rounded-2xl"?', 'a'],
			],
			sh('echo $?'),
			[['1', 'o']],
		],
	},
	{
		id: 'mcp',
		cmd: 'tela mcp',
		verb: 'Delegate',
		title: 'Let an agent drive the loop.',
		body: 'tela mcp serves the screen over the Model Context Protocol, the way Playwright MCP drives a browser: snapshot, screenshot, click, fill and more, on a headless instance that rebuilds on every edit.',
		lines: [
			sh(mcpAdd),
			[['', 'd']],
			[['→ snapshot {}', 'a']],
			[['Built and mounted in 1.1s.', 'd']],
			[['- heading "Settings" [level=1] [ref=e1]', 'o']],
			[['- switch "Weekly digest" [ref=e12]', 'o']],
			[['- button "Save changes" [disabled] [ref=e32]', 'o']],
			[['→ click {"ref": "e12"}', 'a']],
			[['Clicked switch "Weekly digest" [ref=e12].', 'd']],
			[['- switch "Weekly digest" [checked] [ref=e12]', 'o']],
			[['- button "Save changes" [ref=e32]', 'o']],
		],
	},
	{
		id: 'dev',
		cmd: 'tela dev',
		verb: 'Keep going',
		title: 'Edit, save, keep your state.',
		body: 'For people, tela dev rebuilds in the background and swaps the new build into the same window, in about 0.6 s on examples/dashboard.',
		lines: [
			sh('tela dev ./examples/dashboard'),
			[['# save a .go file: the app is rebuilt in the background', 'd']],
			[['# the window never closes; the new build takes its place', 'd']],
			[['# kept: hook state, text fields, scroll offsets and focus', 'd']],
		],
	},
];

// ---------- Real apps ----------
// The example apps, shown one at a time in the big window (section 03).
const slides = [
	{ id: 'dashboard', src: dashboard, dark: dashboardDark, name: 'Dashboard', path: 'examples/dashboard', alt: 'A dashboard drawn by Tela: revenue chart, KPIs, an orders table and an activity feed.' },
	{ id: 'notes', src: notes, name: 'Notes', path: 'examples/notes', alt: 'A notes app drawn by Tela: folders, a note list and an editor.' },
	{ id: 'chat', src: chat, name: 'Messages', path: 'examples/chat', alt: 'A chat app drawn by Tela: conversations, message bubbles and an input.' },
	{ id: 'player', src: player, name: 'Music player', path: 'examples/player', alt: 'A music player drawn by Tela: album art, a seek slider and a track list.' },
	{ id: 'kit', src: kit, dark: kitDark, name: 'kit', path: 'examples/kit', alt: 'The kit component gallery drawn by Tela, on its Introduction page.' },
];
---

<StarlightPage
	frontmatter={{
		title: 'Desktop UIs in pure Go',
		description: 'A desktop UI framework in pure Go. Write components, render to pixels, inspect, lint and iterate from the terminal.',
		template: 'splash',
		// A hero makes Starlight render the Hero component (src/components/Hero.astro,
		// empty here) instead of a page title; the page draws its own first viewport.
		hero: {},
	}}
>
	<div class="lp not-content">
		<!-- ================= Hero: the first viewport ================= -->
		<section class="lp-hero">
			<div class="lp-wrap">
				<p class="lp-chip"><span class="lp-dot"></span>{VERSION} · pre-1.0</p>
				<h1 id="_top">Go in. <span class="soft">Pixels out.</span></h1>

				<div class="lp-start">
					<div class="lp-start-copy">
						<p class="lp-lede">
							A desktop UI framework in pure Go: React-style hooks, Tailwind v4 classes, no cgo and no webview. It
							draws every pixel itself, so the same program renders to a window, to a PNG and to text.
						</p>
						<div class="lp-actions">
							<a class="lp-btn primary" href="/docs/getting-started/">Get started</a>
							<a class="lp-btn" href="https://github.com/kuronosu/tela">GitHub</a>
						</div>
						<p class="lp-label lp-facts">Linux and Windows today · macOS planned · BSD 3-Clause</p>
					</div>

					<div class="lp-start-blocks">
						<!-- Install, with OS tabs -->
						<div class="lp-panel lp-install" data-tabs data-copy-scope>
							<div class="lp-bar">
								<div class="lp-tabs" role="tablist" aria-label="Operating system">
									<button class="lp-tab" role="tab" id="os-linux" aria-controls="os-linux-p" aria-selected="true" tabindex="0" type="button">Linux</button>
									<button class="lp-tab" role="tab" id="os-windows" aria-controls="os-windows-p" aria-selected="false" tabindex="-1" type="button">Windows</button>
									<button class="lp-tab lp-planned" role="tab" id="os-macos" aria-controls="os-macos-p" aria-selected="false" tabindex="-1" type="button">macOS <span class="lp-soon">planned</span></button>
								</div>
								<button class="lp-copy" type="button" data-copy-active>Copy</button>
							</div>
							<div class="lp-tabpanel" role="tabpanel" id="os-linux-p" aria-labelledby="os-linux" data-copy={installLinux.join('\n')}>
								<pre>{installLinux.map((l) => <span class="lp-ln"><span class="p">$ </span><span class="c">{l}</span></span>)}</pre>
							</div>
							<div class="lp-tabpanel" role="tabpanel" id="os-windows-p" aria-labelledby="os-windows" data-copy={installWindows.join('\n')} hidden>
								<pre>{installWindows.map((l) => <span class="lp-ln"><span class="p">PS&gt; </span><span class="c">{l}</span></span>)}</pre>
							</div>
							<div class="lp-tabpanel lp-nowin" role="tabpanel" id="os-macos-p" aria-labelledby="os-macos" hidden>
								<p><strong>No window backend yet; macOS is phase 14.</strong></p>
								<p>The code cross-compiles with <code>GOOS=darwin</code> today, but it cannot open a window.</p>
							</div>
							<p class="lp-foot">Go 1.27+. Needs a Wayland or X11 session on Linux. <code>go install</code> puts <code>tela</code> in <code>$(go env GOPATH)/bin</code>.</p>
						</div>

						<!-- The agent block -->
						<div class="lp-panel lp-agent" data-copy-scope>
							<div class="lp-bar">
								<span class="lp-fname">Or let your agent do it.</span>
								<button class="lp-copy" type="button" data-copy={agentPrompt}>Copy prompt</button>
							</div>
							<p class="lp-prompt"><span class="p" aria-hidden="true">&gt; </span>{agentPrompt}</p>
							<div class="lp-foot lp-mcp">
								<span>Claude Code can also see and click the screen:</span>
								<span class="lp-inline-cmd">
									<code>{mcpAdd}</code>
									<button class="lp-copy lp-copy-s" type="button" data-copy={mcpAdd}>Copy</button>
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Code beside the window it draws -->
			<div class="lp-wrap lp-pair">
				<CodePanel file="examples/counter/main.go" src={counterSource} />

				<div class="lp-bridge" aria-hidden="true">
					<div class="lp-hop">
						<span class="lp-pill">go run</span>
						<svg viewBox="0 0 120 12" preserveAspectRatio="none"><path d="M0 6h112m0 0-6-5m6 5-6 5" /></svg>
						<span class="lp-note">a window</span>
					</div>
					<div class="lp-hop">
						<span class="lp-pill">tela snapshot</span>
						<svg viewBox="0 0 120 12" preserveAspectRatio="none"><path d="M0 6h112m0 0-6-5m6 5-6 5" /></svg>
						<span class="lp-note">a PNG</span>
					</div>
				</div>

				<Window title="Demo">
					<Image
						src={counter}
						widths={[420, 640, 800]}
						sizes="(min-width: 64rem) 440px, 92vw"
						alt="The counter rendered by Tela: a card with the label COUNT, a large 0 and a dark Increment button on a stone background."
						loading="eager"
					/>
					<figcaption class="lp-cap">Rendered by Tela itself. Chromium draws the same markup to equal pixels, glyph antialiasing aside.</figcaption>
				</Window>
			</div>
		</section>

		<!-- ================= Tabs: code and pixels ================= -->
		<section class="lp-section" id="shapes">
			<div class="lp-wrap">
				<header class="lp-shead">
					<p class="lp-label">01 · What it looks like</p>
					<h2>The code on the left draws the pixels on the right.</h2>
					<p class="lp-sub">Five small programs, each rendered by <code>tela snapshot</code> from exactly the source shown.</p>
				</header>

				<div class="lp-shapes" data-tabs>
					<div class="lp-tabs lp-tabs-line" role="tablist" aria-label="Examples">
						{
							tabs.map((t, i) => (
								<button class="lp-tab" role="tab" id={`tab-${t.id}`} aria-controls={`tab-${t.id}-p`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">
									{t.label}
								</button>
							))
						}
					</div>
					{
						tabs.map((t, i) => (
							<div class="lp-tabpanel lp-shape" role="tabpanel" id={`tab-${t.id}-p`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
								<p class="lp-blurb">{t.blurb}</p>
								<div class="lp-shape-pair">
									<CodePanel file="main.go" src={t.src} />
									<Window title={t.label}>
										<Shot src={t.img} dark={t.dark} alt={t.alt} widths={[480, 720, 960]} sizes="(min-width: 64rem) 460px, 92vw" />
										<figcaption class="lp-cap">
											Rendered by Tela itself: <code>tela snapshot --scale 2{t.dark && <span class="lp-dark-i"> --dark</span>} ./{t.id}</code>
										</figcaption>
									</Window>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- ================= The loop: one terminal ================= -->
		<section class="lp-section lp-loop" id="loop">
			<div class="lp-wrap">
				<header class="lp-shead">
					<p class="lp-label">02 · The loop</p>
					<h2>Every screen is also a PNG and a text tree.</h2>
					<p class="lp-sub">So you, your AI agent and your CI can all run the same loop from a terminal.</p>
					<p class="lp-cycle" aria-label="The loop: write, snapshot, look, inspect, fix">
						<span>write</span><b>→</b><span class="hit">tela snapshot</span><b>→</b><span>look</span><b>→</b><span class="hit">tela inspect</span><b>→</b><span>fix</span><b>↺</b>
					</p>
				</header>

				<div class="lp-loop-grid" data-tabs>
					<div class="lp-cmds" role="tablist" aria-label="The tela commands" aria-orientation="vertical">
						{
							steps.map((s, i) => (
								<button class="lp-cmd" role="tab" id={`cmd-${s.id}`} aria-controls={`cmd-${s.id}-p`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<span class="name">{s.cmd}</span>
									<span class="ttl">{s.title}</span>
								</button>
							))
						}
					</div>

					<div class="lp-panel lp-term">
						<div class="lp-bar">
							<span class="lp-dots" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="lp-fname">terminal</span>
						</div>
						{
							steps.map((s, i) => (
								<div class="lp-tabpanel" role="tabpanel" id={`cmd-${s.id}-p`} aria-labelledby={`cmd-${s.id}`} hidden={i !== 0}>
									<pre>{s.lines.map((l) => <span class="lp-ln">{l.map(([t, c]) => (c ? <span class={c}>{t}</span> : t))}</span>)}</pre>
									{s.shot && (
										<div class="lp-result">
											<Image src={counter} widths={[160, 320]} sizes="112px" alt="counter.png, the rendered counter" />
											<div>
												<p class="o">counter.png</p>
												<p class="d">{counter.width}×{counter.height} px, drawn by Tela, headless</p>
											</div>
										</div>
									)}
									<p class="lp-termnote"><b>{s.verb}.</b> {s.body}</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- ================= Real apps, one window at a time ================= -->
		<section class="lp-section lp-big" id="app">
			<div class="lp-wrap">
				<header class="lp-shead">
					<p class="lp-label">03 · Real apps</p>
					<h2>One binary, one window, every pixel yours.</h2>
					<p class="lp-sub">The example apps in <code>examples/</code>, drawn by Tela.</p>
				</header>
				<div class="lp-car" data-carousel>
					<Window title={slides[0].path} mono titleAttrs={{ 'data-car-title': '', 'aria-live': 'polite' }}>
						<span class="lp-wnote" slot="end"><span class="lp-dot"></span>rendered by Tela</span>
						<div class="lp-car-track" data-car-track tabindex="0" role="region" aria-roledescription="carousel" aria-label="Example apps drawn by Tela">
							{
								slides.map((sl, i) => (
									<div class="lp-car-slide" id={`app-${sl.id}`} data-path={sl.path} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}: ${sl.name}`}>
										<Shot src={sl.src} dark={sl.dark} alt={sl.alt} widths={[640, 960, 1280, 1440]} sizes="(min-width: 75rem) 1184px, 100vw" />
									</div>
								))
							}
						</div>
					</Window>
					<div class="lp-car-nav">
						<button type="button" class="lp-car-arrow" data-car-prev aria-label="Previous app">&larr;</button>
						<ol class="lp-car-list">
							{
								slides.map((sl, i) => (
									<li>
										<button type="button" class="lp-car-pick" data-car-go={i} aria-controls={`app-${sl.id}`} aria-current={i === 0 ? 'true' : 'false'}>
											<b>{sl.name}</b>
											<code>{sl.path}</code>
										</button>
									</li>
								))
							}
						</ol>
						<button type="button" class="lp-car-arrow" data-car-next aria-label="Next app">&rarr;</button>
					</div>
				</div>
			</div>
		</section>

		<!-- ================= Comparison ================= -->
		<section class="lp-section lp-compare" id="compare">
			<div class="lp-wrap">
				<header class="lp-shead">
					<p class="lp-label">04 · Compared</p>
					<h2>Where Tela stands, honestly.</h2>
					<p class="lp-sub">Against Fyne, Gio, Wails and Electron. Tela is pre-1.0, so some cells say no or planned.</p>
				</header>
				<Compare />
			</div>
		</section>

		<!-- ================= Closing call to action ================= -->
		<section class="lp-section lp-cta">
			<div class="lp-wrap">
				<div class="lp-panel lp-ctabox" data-copy-scope>
					<p class="lp-label">05 · Start the loop</p>
					<h2>Install the command, render the counter.</h2>
					<div class="lp-ctalines">
						<div class="lp-ctaline">
							<pre class="lp-install-line"><span class="p">$ </span><span class="c">{installLinux[0]}</span></pre>
							<button class="lp-copy lp-copy-s" type="button" data-copy={installLinux[0]}>Copy</button>
						</div>
						<div class="lp-ctaline">
							<p class="lp-install-line lp-agent-line"><span class="p" aria-hidden="true">&gt; </span>Read https://telaui.dev/llms.txt and build a Tela app that …</p>
							<button class="lp-copy lp-copy-s" type="button" data-copy={agentPrompt}>Copy prompt</button>
						</div>
					</div>
					<div class="lp-actions">
						<a class="lp-btn light" href="/docs/getting-started/">Get started</a>
						<a class="lp-btn dark" href="/docs/">Docs</a>
						<a class="lp-btn dark" href="/docs/reference/tela/">API reference</a>
						<a class="lp-btn dark" href="https://github.com/kuronosu/tela">GitHub</a>
					</div>
				</div>
				<p class="lp-status">
					<span>{VERSION}</span><i></i><span>pre-1.0: the API may still change</span><i></i><span>Linux and Windows, macOS planned</span><i></i><span>BSD 3-Clause</span>
				</p>
			</div>
		</section>
	</div>
</StarlightPage>

<script>
	// The example-app carousel: a scroll-snap track that also works without
	// JavaScript (swipe or scroll); the script adds arrows, the app list,
	// arrow keys and the window title. No autoplay.
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('[data-car-track]');
		const title = root.querySelector<HTMLElement>('[data-car-title]');
		if (!track) return;
		const slides = Array.from(track.querySelectorAll<HTMLElement>('.lp-car-slide'));
		const picks = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-car-go]'));
		const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
		let current = 0;
		const mark = (i: number) => {
			current = i;
			picks.forEach((p, j) => p.setAttribute('aria-current', String(j === i)));
			if (title) title.textContent = slides[i].dataset.path ?? '';
		};
		const go = (i: number) => {
			const n = (i + slides.length) % slides.length;
			track.scrollTo({ left: n * track.clientWidth, behavior: smooth() });
			mark(n);
		};
		root.querySelector('[data-car-prev]')?.addEventListener('click', () => go(current - 1));
		root.querySelector('[data-car-next]')?.addEventListener('click', () => go(current + 1));
		picks.forEach((p) => p.addEventListener('click', () => go(Number(p.dataset.carGo))));
		track.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
			if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
		});
		let t = 0;
		track.addEventListener('scroll', () => {
			clearTimeout(t);
			t = window.setTimeout(() => {
				const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
				if (i !== current && slides[i]) mark(i);
			}, 80);
		});
	});

	// Tabs (roving tabindex; Left/Right, Up/Down, Home, End) and copy buttons.
	// Without JavaScript the first panel of every tab group stays visible.
	document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
		const list = root.querySelector<HTMLElement>('[role="tablist"]');
		if (!list) return;
		const tabs = Array.from(list.querySelectorAll<HTMLElement>('[role="tab"]'));
		const select = (tab: HTMLElement, focus = false) => {
			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
				if (panel) panel.hidden = !on;
			}
			if (focus) tab.focus();
		};
		tabs.forEach((t) => t.addEventListener('click', () => select(t)));
		list.addEventListener('keydown', (e) => {
			const i = tabs.indexOf(document.activeElement as HTMLElement);
			if (i < 0) return;
			let n = -1;
			if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % tabs.length;
			else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
			else if (e.key === 'Home') n = 0;
			else if (e.key === 'End') n = tabs.length - 1;
			if (n < 0) return;
			e.preventDefault();
			select(tabs[n], true);
		});
	});

	document.querySelectorAll<HTMLButtonElement>('.lp-copy').forEach((btn) => {
		const label = btn.textContent ?? 'Copy';
		btn.addEventListener('click', async () => {
			let text = btn.dataset.copy;
			if (text === undefined) {
				const scope = btn.closest('[data-copy-scope]');
				text = scope?.querySelector<HTMLElement>('[role="tabpanel"]:not([hidden])[data-copy]')?.dataset.copy;
			}
			if (!text) return;
			try {
				await navigator.clipboard.writeText(text);
				btn.textContent = 'Copied';
			} catch {
				btn.textContent = 'Press Ctrl+C';
			}
			setTimeout(() => (btn.textContent = label), 1600);
		});
	});
</script>

